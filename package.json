{
  "name": "borgas-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:site": "astro preview --host 127.0.0.1 --port 4322 --background && playwright test",
    "test:contact": "node tools/check-contact.mjs",
    "test:commerce": "node --test --test-isolation=none commerce/*.test.mjs",
    "build:commerce": "wrangler deploy --dry-run --env=\"\" --config commerce/wrangler.jsonc --outdir .wrangler/build",
    "build:commerce:production": "wrangler deploy --dry-run --env production --config commerce/wrangler.jsonc --outdir .wrangler/build-production"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "private": true,
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.132.0"
  }
}
