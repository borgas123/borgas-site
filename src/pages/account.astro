---
import Base from '../layouts/Base.astro';
import '../styles/commerce.css';
---
<Base title="Your account" description="Sign in to your BORGAS account to see your orders." noindex><section class="section"><div class="wrap"><p class="eyebrow">BORGAS / Your account</p><h1>Your hardware.<br/>Your history.</h1><div class="panel account-panel"><p id="account-notice">Customer accounts are being prepared. Sign-in will be available when the shop opens.</p><form id="email-form" hidden><h2>Sign in or create an account</h2><p>We'll email you a secure sign-in link. Open it in this same browser. No password to remember.</p><label for="email">Email address</label><input id="email" type="email" autocomplete="email" required maxlength="254"/><button class="shop-btn" type="submit">Email me a sign-in link</button><p class="small">By continuing, you acknowledge our <a href="/privacy/">privacy notice</a>.</p></form><form id="code-form" hidden><label for="code">Code from your email</label><input id="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" required maxlength="10"/><button class="shop-btn" type="submit">Verify and sign in</button><button class="shop-btn secondary" id="change-email" type="button">Use a different email</button></form><div id="signed-in" hidden><h2>Welcome back.</h2><p id="account-email"></p><div class="actions"><a class="shop-btn" href="/cart/">Go to cart</a><button id="sign-out" class="shop-btn secondary">Sign out</button></div></div><div id="sandbox-controls" hidden><p class="notice" style="margin-top:24px">Sandbox testing only. No real payments.</p><button id="sandbox-check" class="shop-btn secondary" type="button">Check PayPal Sandbox connection</button></div><p id="account-status" class="shop-status" role="status" aria-live="polite"></p></div><section id="order-history" hidden style="margin-top:40px"><h2>Your orders</h2><div id="orders"></div></section></div></section></Base>
<script>import '../scripts/account';</script>