---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import ProductCard from "../components/ProductCard.astro";
import { byFamily, families, productBySlug } from "../data/products";
const brc = productBySlug("brc-02")!;
---
<Base title="Home" description="BORGAS builds electronic hardware for sim racing and field diagnostics. Explore the BRC-02 racing dashboard and diagnostic tools." isHome>
<section class="section hero"><div class="wrap split">
<div><p class="eyebrow">BORGAS / Electronics & technology</p><h1>Electronics<br />with purpose.</h1><p class="lede">From the racing rig to the workbench. Hardware built around the information you need, when you need it.</p><div class="actions"><Button href="/products/brc-02/">Explore BRC-02 <span aria-hidden="true">↗</span></Button><Button href="/shop/" variant="secondary">Shop BORGAS</Button></div><p class="hero-note">Racing Systems &nbsp; / &nbsp; Diagnostic Systems</p></div>
<div class="brand-stage glow"><img src="/mark.png" alt="BORGAS raven and wordmark" width="511" height="437" fetchpriority="high" /><p>Independent electronics. Hands-on engineering.</p></div>
</div></section>
<section class="section"><div class="wrap"><p class="eyebrow">Explore the range</p><h2>Two product families.<br />One BORGAS.</h2><div class="grid grid-2 family-grid">{Object.entries(families).map(([id,f])=><a class="family-feature" href={f.slug}><span class="eyebrow">{id === "racing" ? "01 / At the wheel" : "02 / In the field"}</span><h3>{f.name} <span aria-hidden="true">↗</span></h3><p>{f.blurb}</p><span class="family-detail">{id === "racing" ? "Dashboards · Shift lighting · Session flags" : "Measurement · Signal capture · Portable power"}</span></a>)}</div></div></section>
<section class="section feature-section"><div class="wrap split"><figure class="display-stage"><img src={brc.images[0].src} alt={brc.images[0].alt} width="320" height="240" loading="lazy"/><figcaption>{brc.images[0].caption}</figcaption></figure><div><p class="eyebrow">Featured / Racing Systems</p><h2>BRC-02.<br />Keep your eyes on the race.</h2><p>Gear, revs and vital telemetry at the wheel. Dedicated lighting puts shift points and session flags where you can see them.</p><ul class="feature-list"><li><strong>Your view, your layout.</strong> Ten dashboard layouts, selected from the Windows configurator.</li><li><strong>Know when to shift.</strong> Tune the RPM lighting to a percentage of each car's rev limit.</li><li><strong>See the call.</strong> Separate flag matrices and left/right spotter indications.</li></ul><Button href="/products/brc-02/">Discover the dashboard</Button></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Beyond the dashboard</p><h2>Tools with a clear role.</h2></div><a href="/products/">Explore all products ↗</a></div><div class="grid grid-3">{[...byFamily("racing").filter(p=>p.id!=="brc-02"),...byFamily("diagnostics")].slice(0,3).map(p=><ProductCard product={p}/>)}</div></div></section>
<section class="section"><div class="wrap split"><div><p class="eyebrow">How we build</p><h2>From a real problem<br />to working hardware.</h2></div><div><p>Identify the problem. Build and test. Refine the details. BORGAS grows through hands-on work, from dashboard behavior on track to measurements at the bench.</p><a href="/about/">The approach behind BORGAS ↗</a></div></div></section>
<section class="section closing"><div class="wrap section-heading"><div><p class="eyebrow">Already using BORGAS?</p><h2>Get back to what you do.</h2><p>Find product help, setup information and released software.</p></div><div class="actions"><Button href="/support/">Find support</Button><Button href="/contact/" variant="secondary">Contact BORGAS</Button></div></div></section>
</Base>
