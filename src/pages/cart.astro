---
import Base from '../layouts/Base.astro';
import '../styles/commerce.css';
---
<Base title="Your cart" description="Review your BORGAS products and checkout details." noindex>
<section class="section"><div class="wrap"><p class="eyebrow">BORGAS / Your cart</p><h1>Your next setup.</h1><div class="cart-layout"><div><div id="cart-lines"></div><p id="empty-cart" hidden>Your cart is empty. <a href="/shop/">Explore the shop.</a></p><a href="/shop/">← Continue shopping</a>
<form id="shipping-form" class="checkout-fields" hidden><h2>Delivery details</h2><p>US delivery addresses only. Availability is checked before payment.</p><label for="full-name">Full name</label><input id="full-name" name="fullName" autocomplete="shipping name" required maxlength="100"/><label for="address">Street address</label><input id="address" name="addressLine1" autocomplete="shipping address-line1" required maxlength="200"/><label for="address2">Apartment / suite (optional)</label><input id="address2" name="addressLine2" autocomplete="shipping address-line2" maxlength="200"/><div class="field-pair"><div><label for="city">City</label><input id="city" name="city" autocomplete="shipping address-level2" required maxlength="100"/></div><div><label for="state">State (two-letter code)</label><input id="state" name="state" autocomplete="shipping address-level1" required pattern="[A-Za-z]{2}" maxlength="2" placeholder="NY"/></div></div><label for="zip">ZIP code</label><input id="zip" name="postalCode" autocomplete="shipping postal-code" required pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10"/><button class="shop-btn" type="submit" style="margin-top:24px">Review total</button></form></div>
<aside class="panel summary" aria-label="Order summary"><h2>Order summary</h2><dl><div><dt>Subtotal</dt><dd id="subtotal">$0.00</dd></div><div><dt>Discount</dt><dd id="discount">—</dd></div><div><dt>Shipping</dt><dd id="shipping">At checkout</dd></div><div><dt>Tax</dt><dd id="tax">At checkout</dd></div><div class="total"><dt id="total-label">Item total</dt><dd id="total">$0.00</dd></div></dl><form id="coupon-form"><label for="coupon">Discount code</label><div class="coupon"><input id="coupon" maxlength="40" autocomplete="off" spellcheck="false"/><button class="shop-btn secondary" type="submit">Apply</button></div></form><p id="coupon-status" class="shop-status" role="status"></p><p id="checkout-status" class="notice">Online checkout is being prepared. You won't be charged.</p><a id="sign-in" href="/account/?next=cart" hidden>Sign in to continue</a><div id="paypal-buttons"></div><div id="sandbox-fallback" hidden style="display:grid;gap:10px;margin-top:12px"><button id="sandbox-open" class="shop-btn secondary" type="button">Open Sandbox approval page</button><button id="sandbox-finish" class="shop-btn secondary" type="button">Finish approved Sandbox payment</button></div><p id="payment-status" class="shop-status" role="status" aria-live="polite"></p><p class="small">All prices in USD. US shipping only. By paying, you agree to the <a href="/shipping-returns/">shipping and return policy</a>; BORGAS Asset Creator purchases follow the <a href="/bac/refunds/">BAC refund policy</a> and <a href="/bac/license/">license agreement</a>.</p></aside></div><noscript><p>JavaScript is needed to load your cart. <a href="/contact/">Contact BORGAS</a> for help.</p></noscript></div></section>
</Base>
<script>import '../scripts/cart';</script>
