---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import ProductCard from "../components/ProductCard.astro";
import {families,byFamily,type Family} from "../data/products";
export function getStaticPaths(){return Object.keys(families).map(family=>({params:{family}}));}
const id=Astro.params.family as Family;const family=families[id];const products=byFamily(id);
---
<Base title={family.name} description={family.blurb}><section class="section"><div class="wrap"><p class="eyebrow">BORGAS / {id==="racing"?"At the wheel":"In the field"}</p><h1>{family.name}.</h1><p class="lede">{family.blurb}</p><div class="grid grid-2 family-grid">{products.map(p=><ProductCard product={p}/>)}</div></div></section><section class="section"><div class="wrap split"><h2>{id==="racing"?"A place for every signal.":"Different tools. A shared purpose."}</h2><div><p>{id==="racing"?"BRC-02 combines the dashboard, RPM lighting and lap displays. BRC-FL places larger session-flag panels elsewhere on your rig. Each connects to SimHub as its own USB serial device.":"BFD-01 gathers measurements and signal history. BPS-01 supports portable use with rechargeable power. The wider diagnostic ecosystem is in development; capabilities and compatibility are specific to each device."}</p><div class="actions"><Button href="/support">Product support</Button><Button href="/contact" variant="secondary">Discuss your setup</Button></div></div></div></section></Base>
